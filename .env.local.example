# InnVolt ERP — Variables de entorno
# Copia este archivo como `.env.local` y reemplaza con tus valores reales.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── IA para cotizar y crear recetas ────────────────────────────────────────
# Se usa en el cotizador (Cotizar con IA) y en la biblioteca (Generar receta con
# IA). Solo se usa en el servidor (nunca se expone al navegador). Agrega la key
# también en Netlify → Site settings → Environment variables para producción.
#
# OPCIÓN GRATIS (recomendada) — Google Gemini:
#   Consigue una key gratis en https://aistudio.google.com/apikey (sin tarjeta).
GEMINI_API_KEY=AIza...
# (opcional) Modelo Gemini. Por defecto: gemini-2.0-flash (gratis, rápido).
# GEMINI_MODEL=gemini-2.0-flash
#
# OPCIÓN DE PAGO — Anthropic (Claude), mayor calidad:
# ANTHROPIC_API_KEY=sk-ant-...
# IA_MODEL=claude-opus-5
#
# Proveedor a usar. Si se omite, se auto-detecta (prioriza Gemini si hay key).
# IA_PROVIDER=gemini   # o: anthropic
