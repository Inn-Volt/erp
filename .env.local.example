# InnVolt ERP — Variables de entorno
# Copia este archivo como `.env.local` y reemplaza con tus valores reales.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── IA para cotizar (Claude) ───────────────────────────────────────────────
# Clave de la API de Anthropic (https://console.anthropic.com → API Keys).
# Es de pago y es DISTINTA de tu suscripción de Claude Code. Solo se usa en el
# servidor (nunca se expone al navegador). Agrégala también en Netlify → Site
# settings → Environment variables para que funcione en producción.
ANTHROPIC_API_KEY=sk-ant-...
# (opcional) Modelo a usar. Por defecto: claude-opus-5.
# Alternativa más económica/rápida: claude-sonnet-5
# IA_MODEL=claude-opus-5
